<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/alarm_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:paddingTop="56dp"
        android:paddingBottom="32dp">

        <TextView
            android:id="@+id/alarmLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/alarm_time_to_pray"
            android:textAllCaps="true"
            android:textColor="@color/alarm_gold"
            android:textSize="15sp"
            android:letterSpacing="0.22"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/timeText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="6:30"
            android:textColor="@color/alarm_ivory"
            android:textSize="76sp"
            android:fontFamily="sans-serif-light" />

        <TextView
            android:id="@+id/dateText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text=""
            android:textColor="@color/alarm_dim"
            android:textSize="15sp"
            android:layout_marginTop="4dp" />

        <View
            android:layout_width="56dp"
            android:layout_height="3dp"
            android:layout_marginTop="28dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/alarm_divider" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:gravity="center"
            android:text="❝"
            android:textColor="@color/alarm_gold"
            android:textSize="46sp"
            android:fontFamily="serif" />

        <TextView
            android:id="@+id/verseText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:lineSpacingExtra="8dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text=""
            android:textColor="@color/alarm_ivory"
            android:textSize="22sp"
            android:fontFamily="serif" />

        <TextView
            android:id="@+id/verseRef"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:text=""
            android:textColor="@color/alarm_gold"
            android:textSize="17sp"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="❞"
            android:textColor="@color/alarm_gold"
            android:textSize="46sp"
            android:fontFamily="serif" />

        <TextView
            android:id="@+id/holdText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:gravity="center"
            android:letterSpacing="0.12"
            android:text="@string/alarm_verse_hold"
            android:textAllCaps="true"
            android:textColor="@color/alarm_dim"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnPrayNow"
                android:layout_width="0dp"
                android:layout_height="58dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:background="@drawable/alarm_button_primary"
                android:fontFamily="sans-serif-medium"
                android:text="@string/alarm_pray_now"
                android:textAllCaps="false"
                android:textColor="#14120A"
                android:textSize="17sp" />

            <Button
                android:id="@+id/btnDismiss"
                android:layout_width="0dp"
                android:layout_height="58dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:background="@drawable/alarm_button_secondary"
                android:fontFamily="sans-serif-medium"
                android:text="@string/alarm_dismiss"
                android:textAllCaps="false"
                android:textColor="@color/alarm_dim"
                android:textSize="17sp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>